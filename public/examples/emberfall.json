        "y": 140
      },
      "createdAt": 1726259200000,
      "updatedAt": 1726262800000
    },
    {
      "id": "node-lampwright-guild",
      "universeId": "universe-emberfall",
      "type": "organization",
      "name": "铸灯人公会",
      "description": "盘踞烬港工坊街的匠人结社，垄断星铁与青铜灯的锻造。他们修复遗物、贩卖信标，也悄悄拆解从海底打捞上来的神性零件。",
      "properties": {
        "性质": "匠人结社",
